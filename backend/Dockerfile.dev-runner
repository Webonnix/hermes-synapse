# Sandbox container for autonomous dev-runs: filesystem + argv exec over the
# mounted dev-repo only. No Hermes backend code besides dev_runner_api.py.
FROM python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93

ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir "fastapi==0.162.0" "uvicorn==0.54.0" "pytest==8.3.5"

RUN useradd --create-home --uid 10001 runner \
    && mkdir -p /dev-repo && chown runner:runner /dev-repo \
    && git config --system safe.directory /dev-repo \
    && git config --system user.email "agent@hermes.local" \
    && git config --system user.name "Hermes Dev Agent"

COPY backend/dev_runner_api.py /runner/dev_runner_api.py

USER runner
WORKDIR /dev-repo

EXPOSE 8600

CMD ["uvicorn", "dev_runner_api:app", "--app-dir", "/runner", "--host", "0.0.0.0", "--port", "8600", "--no-access-log"]
