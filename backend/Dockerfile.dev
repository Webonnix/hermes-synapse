FROM python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Same locked dependency set as backend/Dockerfile (see the comment there).
# watchfiles is dev-only (uvicorn --reload) and not in the lock, so it is
# pinned here instead.
COPY --from=ghcr.io/astral-sh/uv:0.12.1@sha256:cf4eedcaa81655197f625739489effcbe71b61ceb1506f332c3facae5deceded /uv /usr/local/bin/uv
COPY backend/pyproject.toml backend/uv.lock /tmp/uv-lock/
RUN cd /tmp/uv-lock \
    && uv export --quiet --frozen --no-emit-project --group dev --format requirements-txt -o requirements.txt \
    && uv pip install --system --no-cache --require-hashes -r requirements.txt \
    && uv pip install --system --no-cache "watchfiles==1.3.0" \
    && rm -rf /tmp/uv-lock

COPY backend/ /app/backend/

EXPOSE 8000

# --reload enables hot-reload via watchfiles
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "/app/backend"]
