# ====================================================================
# Hermes (Jarvis): Environment Configuration Template
# Copy this file to .env and fill in your keys.
# ====================================================================

# ── LLM PROVIDER ─────────────────────────────────────────────────────
# Ollama is the default and needs no API key. OpenRouter and generic
# OpenAI-compatible endpoints remain available as optional providers.
# Provider: ollama | openrouter | openai_compatible
LLM_PROVIDER=ollama
# Native Ollama server (without /api or /v1). In Docker Compose this is
# overridden to http://ollama:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Production containers can pin the provider endpoint so a stale dashboard
# setting cannot replace the Docker service address with localhost.
LLM_LOCK_PROVIDER_ENDPOINT=false
# Optional bearer token for a protected remote Ollama endpoint. Leave empty for
# the standard local/Docker server.
OLLAMA_API_KEY=

# Required. Gates the frontend's /ollama/ reverse-proxy path (nginx checks
# `Authorization: Bearer <this value>` before forwarding to the internal
# Ollama server) so external OpenAI/Ollama-compatible clients (e.g. Cline)
# can reach Ollama over the network with just a token, no SSH tunnel.
# Generate with: openssl rand -hex 32
OLLAMA_PROXY_TOKEN=
LLM_MODEL=hf.co/unsloth/Qwen3.6-35B-A3B-GGUF:UD-Q4_K_M

# Optional cloud/OpenAI-compatible fallback.
LLM_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Fast local-model defaults. These keep Telegram responsive when using Ollama
# or another local OpenAI-compatible backend.
LLM_FAST_MODE=false
LLM_MAX_HISTORY_MESSAGES=6
LLM_MAX_TOKENS=2048
LLM_TOOL_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
# Provider resilience. Retries apply only to transient failures and are disabled
# after a tool may have produced side effects.
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=1
LLM_MAX_TOOL_ITERATIONS=8
RAG_AUTO_CONTEXT=false
MEMORY_ENABLED=true
MEMORY_AUTO_SAVE=true
MEMORY_MAX_ITEMS=4
# Encrypts user_memory/subagent_memory at rest (backend/local_crypto.py). If
# unset, a key is auto-generated and persisted in Valkey on first use — set
# this explicitly for any deployment you intend to back up/restore, since a
# lost Valkey volume without a saved key makes existing encrypted rows
# unreadable. Generate one with: python -c "from cryptography.fernet import
# Fernet; print(Fernet.generate_key().decode())"
MEMORY_ENCRYPTION_KEY=

# ── OPTIONAL: Ollama-specific settings ────────────────────────────────
# Context window size passed to Ollama as `num_ctx`.  Increase if your
# system prompt + history is large. The default below targets a 2x RTX 3090,
# 96 GB RAM host; lower it to 65536 or 131072 if another workload needs VRAM.
OLLAMA_NUM_CTX=262144
# How long a model remains loaded: 5m, 1h, -1 (forever), or 0 (unload).
OLLAMA_KEEP_ALIVE=-1
# false | true | low | medium | high (levels require a supporting model).
OLLAMA_THINK=false

# Ollama server tuning used by the bundled Compose service. Flash attention
# plus q8_0 KV cache keeps a very large context substantially more practical.
OLLAMA_CONTEXT_LENGTH=262144
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
CUDA_VISIBLE_DEVICES=0,1

# ── OPTIONAL: Per-agent model overrides ──────────────────────────────
# Override the model used by each specialized agent role.
# Falls back to LLM_MODEL if not set.
#
# Leave blank to use LLM_MODEL. Set installed Ollama model names here only when
# a specialized role genuinely benefits from a different local model.
AGENT_MODEL_RESEARCH=
AGENT_MODEL_CODE=
AGENT_MODEL_ANALYST=
AGENT_MODEL_PLANNER=
AGENT_MODEL_BROWSER=
# keyword/false/off/fast = no extra LLM router call; auto = classifier LLM call.
COMPLEXITY_ROUTING=keyword

# ── SYSTEM BACKEND ───────────────────────────────────────────────────
PORT=8000

# ── TELEGRAM INTERFACE ───────────────────────────────────────────────
# Agents: all agents are accessible via Telegram
# Create a bot via @BotFather → https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Get your numeric chat ID via @userinfobot → https://t.me/userinfobot
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Authorized admin user ID(s) that the bot will respond to (comma-separated if multiple; all others are blocked at code level)
TELEGRAM_ADMIN_ID=your_telegram_admin_id_here

# ── LOCAL VOICE ASSISTANT ───────────────────────────────────────────
# Free local speech-to-text powered by faster-whisper.
# First run downloads the selected model. Use "base" for weaker CPUs,
# "small" for a good default, "medium" if you have more RAM/GPU.
VOICE_STT_ENABLED=true
VOICE_STT_MODEL=small
VOICE_STT_DEVICE=cpu
VOICE_STT_COMPUTE_TYPE=int8
# Empty = auto-detect (recognizes Russian and English in the same deployment).
# Set to a fixed code like "ru" only if you want to force one language.
VOICE_STT_LANGUAGE=
VOICE_STT_VAD_FILTER=true
VOICE_STT_DOWNLOAD_ROOT=/app/backend/data/voice-models
VOICE_STT_PRELOAD=true
VOICE_MAX_UPLOAD_MB=25

# The production image includes Debian's RHVoice engine and the piper-tts pip
# package. Supported providers: auto, piper, rhvoice. Neither engine downloads
# a model at runtime — RHVoice's voices ship in the image, Piper's .onnx models
# must be fetched manually (e.g. from huggingface.co/rhasspy/piper-voices) and
# mounted/copied into the container; VOICE_TTS_PIPER_MODEL(_EN) point at them.
# Piper is a modern neural TTS and sounds far less robotic than RHVoice.
VOICE_TTS_ENABLED=true
VOICE_TTS_PROVIDER=rhvoice
VOICE_TTS_VOICE=anna
# English voice, auto-selected for replies that are mostly Latin script (image
# includes Debian's rhvoice-english package).
VOICE_TTS_VOICE_EN=slt
VOICE_TTS_PIPER_BINARY=piper
VOICE_TTS_PIPER_MODEL=
# Optional second Piper model for replies that are mostly Latin script — same
# auto-pick idea as VOICE_TTS_VOICE_EN, since a Russian Piper voice mangles
# English text just like RHVoice's Russian voice does.
VOICE_TTS_PIPER_MODEL_EN=
VOICE_TTS_RHVOICE_BINARY=RHVoice-test
VOICE_TTS_TIMEOUT_SECONDS=30
VOICE_TTS_MAX_CHARS=4000

# ── SEARCH AGENT & FOOTBALL ANALYST ─────────────────────────────────
# Skill: web_search — powers web search, news, football results
# Google Serper — free tier: 2,500 queries/month → https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# ── SEARCH AGENT: WEATHER ────────────────────────────────────────────
# Skill: web_search (weather sub-feature)
# OpenWeatherMap — free tier: 1,000 calls/day → https://home.openweathermap.org/api_keys
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# ── IMAGE GENERATION ─────────────────────────────────────────────────
# Skill: image_generation (used by the Senior Web Developer agent and any
# other agent with this skill enabled). Paid — each call costs real money
# and is deducted from the calling agent's budget_usd_limit, if one is set.
# Stability AI → https://platform.stability.ai/account/keys
STABILITY_API_KEY=your_stability_api_key_here

# ── DAILY PLANNER: TODOIST ───────────────────────────────────────────
# Skill: todoist_sync
# Todoist → Settings → Integrations → Developer
# → https://app.todoist.com/app/settings/integrations/developer
TODOIST_API_TOKEN=your_todoist_token_here

# ── DAILY PLANNER: GOOGLE CALENDAR ───────────────────────────────────
# Skill: google_calendar — OAuth2 setup (one-time, on host machine)
# 1. Create Desktop OAuth 2.0 credentials at:
#    https://console.cloud.google.com/apis/credentials
# 2. Download the JSON and place it in the project root as client_secret_*.json
# 3. Run once on your host: python3 backend/google_auth.py
#    This generates google_token.json which is volume-mounted into Docker.

# ── OBSIDIAN RAG SKILL ───────────────────────────────────────────────
# Skill: obsidian_rag — local knowledge base search & sync
# Install "Local REST API" plugin in Obsidian:
# → https://github.com/coddingtonbear/obsidian-local-rest-api
OBSIDIAN_API_KEY=your_obsidian_local_rest_api_key_here
# In hermes-web/docker-compose.yml, backend overrides this to "obsidian"
# so it can reach the Obsidian container over the Docker network.
OBSIDIAN_HOST=obsidian
OBSIDIAN_PORT=27124
OBSIDIAN_VAULT_PATH=/config/vaults/Hermes

# Web UI credentials for the Obsidian container.
# Dashboard URL: https://127.0.0.1:3001
# Note: Docker Compose interpolation reads shell variables or hermes-web/.env,
# not env_file values from src/.env. Defaults are set in docker-compose.yml.
OBSIDIAN_WEB_USER=hermes
OBSIDIAN_WEB_PASSWORD=change_me

# ── MARKET DATA PROVIDER ─────────────────────────────────────────────
# Skill: market_monitor — real-time price alerts for crypto & stocks
#
# MARKET_DATA_PROVIDER controls which backend fetches prices.
# Options:
#   http    → Default. CoinGecko (crypto) + Yahoo Finance (stocks).
#             Zero config, zero API keys. Works out of the box.
#   ccxt    → CCXT library. Real-time crypto via any supported exchange.
#             Requires: uv sync --group market-ccxt
#   alpaca  → Alpaca Market Data API. Real-time US equities.
#             Requires: uv sync --group market-alpaca + free Alpaca account.
#
MARKET_DATA_PROVIDER=http

# ── CCXT options (only used when MARKET_DATA_PROVIDER=ccxt) ──────────
# CCXT_EXCHANGE=binance        # Exchange ID. See: https://github.com/ccxt/ccxt/wiki/Exchange-Markets
# CCXT_QUOTE=USDT              # Quote currency for pairs (default: USDT)

# ── Alpaca options (only used when MARKET_DATA_PROVIDER=alpaca) ──────
# ALPACA_API_KEY=your_alpaca_key_here
# ALPACA_API_SECRET=your_alpaca_secret_here
# Sign up (free paper-trading account): https://alpaca.markets

# ── DATABASE (OPTIONAL) ──────────────────────────────────────────────
# Default: SQLite with WAL mode enabled automatically.
# No configuration needed for local development — zero-friction onboarding.
#
# WAL mode benefits (enabled automatically in SQLite):
#   - Eliminates "database is locked" errors under concurrent load
#   - Readers never block writers; writers never block readers
#   - busy_timeout=5000ms prevents crashes on high-concurrency scenarios
#
# To switch to PostgreSQL (optional, for production):
#   1. Install deps:  uv sync --group postgres
#   2. Uncomment and set:
# DATABASE_URL=postgresql://user:password@localhost:5432/hermes
#
# Any SQLAlchemy-compatible URL works (e.g. postgresql+asyncpg://)
# Community contributors: leave this unset — SQLite works out of the box.

# ── AUTONOMY AND PROJECT MEMORY ─────────────────────────────────────
# Docker Compose mounts this repository read-only at /workspace.
# The index stores paths, symbols and imports, never source contents.
PROJECT_MEMORY_AUTO_INDEX=true
AUTONOMY_PROJECT_CONTEXT=true
AUTONOMY_INDEX_MAX_FILES=4000
AUTONOMY_INDEX_MAX_FILE_BYTES=750000
# Exact allowlisted recipes only. Each installation still requires Control Plane approval.
AUTONOMY_INSTALL_ENABLED=false
AUTONOMY_CAPABILITY_ROOT=/app/backend/data/capabilities
AUTONOMY_INSTALL_TIMEOUT_SECONDS=300
# MCP secrets are referenced by name and remain outside mcp_config.json.
# STATIC_BEARER_TOKEN=replace_with_secret_in_the_real_env_only

# ── VALKEY (credential + redaction-mapping store) ───────────────────
# Internal-only container (never exposed to the host). Holds external-provider
# API keys (never written to the SQL DB) and short-lived TTL placeholder->secret
# mappings used by the redaction gateway before a message leaves to an external
# LLM provider. Generate with: openssl rand -hex 32
VALKEY_PASSWORD=replace_with_a_long_random_value

# ── GITEA (agent development repository) ────────────────────────────
# Internal-only Gitea instance (docker-compose service "gitea", web UI on host
# port 3002) backing backend/data/dev-repo — a dedicated read-write git clone
# agents can commit/push to via the git_status/git_diff/git_commit/git_push
# tools (skill: "git_dev"), decoupled from the read-only /workspace project
# mount. Provision once: `docker exec -u git hermes-web-gitea gitea admin user
# create --username hermes-agent --password <pw> --email agent@hermes.local
# --admin --must-change-password=false`, then `gitea admin user
# generate-access-token --username hermes-agent --token-name agent-tool
# --scopes write:repository,write:user`.
GITEA_TOKEN=replace_with_a_generated_access_token
GITEA_URL=http://gitea:3000

# Comma-separated list of origins allowed by backend CORS (dashboard URLs).
HERMES_ALLOWED_ORIGINS=http://localhost:9119,http://127.0.0.1:9119,http://192.168.0.200:9119,https://hermes.webonnix.net

# Internal bearer token protecting the dev-runner sandbox API (generate a long
# random value, e.g. `openssl rand -hex 32`).
DEV_RUNNER_TOKEN=replace_with_a_long_random_token
# Base URL the backend uses to reach the dev-runner container.
DEV_RUNNER_URL=http://dev-runner:8600

# ── Autonomous dev-run loop bounds (all optional; defaults shown) ────
# Runs are unlimited by default (iter_budget 0) but never unbounded: this is
# the last-resort ceiling that stops a run no other gate caught.
DEV_RUNS_HARD_ITERATION_CAP=300
# Identical tool+arguments calls allowed before the loop refuses the action and
# tells the model to change strategy; +2 more and the run fails as a loop.
DEV_RUNS_DUPLICATE_ACTION_LIMIT=3
# Failing steps in a row with no progress before the run stops for the owner.
DEV_RUNS_MAX_CONSECUTIVE_FAILURES=6
# Transient LLM failures (timeout / provider error) retried inside one
# iteration, with exponential backoff, before the run pauses.
DEV_RUNS_LLM_RETRY_ATTEMPTS=3
DEV_RUNS_LLM_RETRY_BASE_DELAY=2
# Crashed iterations the worker retries by itself (after the delay) before it
# really does need a human. Budget/kill-switch pauses are never auto-recovered.
DEV_RUNS_MAX_AUTO_RECOVERIES=3
DEV_RUNS_AUTO_RECOVER_DELAY_SECONDS=30
# Observation context: full tool output stored per step, how many recent steps
# are replayed verbatim to the model, and the character ceiling for that block
# (automatically reduced further to fit a small local OLLAMA_NUM_CTX).
DEV_RUNS_STEP_RESULT_MAX_CHARS=20000
DEV_RUNS_OBSERVATION_STEPS=6
DEV_RUNS_OBSERVATION_BUDGET_CHARS=24000

# ── AI ROUTER (9Router token-saver / fallback sidecar) ───────────────
# Optional sidecar (docker-compose service "9router", github.com/decolua/9router)
# that fronts external LLM providers with an OpenAI-compatible endpoint,
# 3-tier fallback (subscription -> cheap -> free) and tool-output token
# compression. The LOCAL model stays the default for every agent — this is
# opt-in per agent via Admin -> Providers, same governed approve flow as any
# other openai_compatible binding, and every call routed through it still
# passes the same redaction gateway (backend/redaction.py) before anything
# leaves the box. Console/dashboard credentials, not agent-facing:
# First boot of the 9router container itself.
ROUTER_JWT_SECRET=replace_with_a_long_random_value
ROUTER_INITIAL_PASSWORD=replace_with_a_strong_password
# Only matters if you expose 9Router's own dashboard beyond 127.0.0.1:20128.
ROUTER_PUBLIC_BASE_URL=http://localhost:20128
# Set to 0.0.0.0 to publish the container's port on every interface (LAN-
# reachable at <host-ip>:20128) instead of loopback-only. 9Router's own
# password gate (with lockout after repeated failures) is the only thing
# protecting it at that point — treat like any other admin surface you'd
# expose past your firewall.
# ROUTER_PUBLISH_HOST=0.0.0.0
# From 9Router -> Dashboard -> API Keys, after first login. Lets the backend's
# GET /api/router/stats confirm the sidecar is reachable and list its model
# catalog (GET /v1/models — 9Router's quota/usage/combo pages are dashboard-
# session-only, no API for those; see dashboard_url in that response).
# Configure via Settings -> API Keys in the dashboard, not here, once the
# 9router container is up (chicken-and-egg: the key doesn't exist until then).
# ROUTER_API_KEY=
ROUTER_API_BASE=http://9router:20128
# Public hostname the 9Router dashboard answers on (nginx Host/SNI routing —
# see nginx.conf.template's second server block; not path-based, 9Router's
# own routing can't sit under a subpath of the main site). Point a DNS record
# at this origin for that hostname to make it reachable; until then this is
# inert. Leave unset for LAN-only access via an SSH tunnel to 127.0.0.1:20128.
# ROUTER_HOSTNAME=router.example.com

# ── BROWSER AUTOMATION (browser_read / browser_task tools) ──────────
# Skill: browser_automation — a browser-use agent driving a real headless
# Chromium session (navigate, extract, click, fill forms). Off by default:
# both the `browser-runner` Compose service (start with
# `docker compose --profile browser up -d`) and this flag must be set before
# the tools do anything but return a "disabled" message.
BROWSER_AGENT_ENABLED=false
# Internal bearer token protecting the browser-runner sidecar API (generate a
# long random value, e.g. `openssl rand -hex 32`).
BROWSER_RUNNER_TOKEN=replace_with_a_long_random_token
# Base URL the backend uses to reach the browser-runner container.
BROWSER_RUNNER_URL=http://browser-runner:8800
