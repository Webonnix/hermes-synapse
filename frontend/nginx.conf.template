# AI Router (OmniRoute) dashboard, reachable at https://${ROUTER_HOSTNAME}/ — a
# separate server block keyed on Host/SNI rather than a location prefix under
# the main site, because OmniRoute is its own Next.js app: its HTML/JS reference
# assets and API routes (/_next/..., /api/...) at absolute root paths with no
# basePath support, so hosting it under a subpath of the main site (e.g.
# /router/) would silently 404 half its requests — and /api/ would collide
# outright with the main site's own backend proxy below. Same origin cert as
# the main block; Cloudflare tolerates the CN/SAN mismatch the same way it
# already does for the primary hostname (this deployment isn't in Strict SSL
# mode). Only takes effect once ${ROUTER_HOSTNAME} has a DNS record pointed at
# this origin.
#
# THIS BLOCK MUST NOT BE nginx's default_server: with no explicit
# default_server marker, nginx silently makes the *first* server block for a
# given listen socket the fallback for every non-matching Host header —
# regardless of its own server_name — which would hijack all traffic to the
# main site below (including plain IP access and any Host nginx doesn't
# recognize) the moment this block appears first in the file. The main site's
# block carries `default_server` for exactly this reason; don't remove it,
# and don't reorder these two blocks without keeping that in mind.
server {
    listen 80;
    listen 443 ssl;
    http2 on;
    ssl_certificate /etc/nginx/ssl/hermes.crt;
    ssl_certificate_key /etc/nginx/ssl/hermes.key;
    server_name ${ROUTER_HOSTNAME};

    resolver 127.0.0.11 valid=10s;
    set $router_upstream http://omniroute:20128;

    location / {
        proxy_pass $router_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
    }
}

server {
    # default_server: catches every Host nginx doesn't otherwise recognize
    # (plain IP access, ROUTER_HOSTNAME before its DNS record exists, etc.)
    # — see the comment on the AI Router server block above for why this
    # must stay explicit rather than relying on file order.
    listen 80 default_server;
    listen 443 ssl default_server;
    http2 on;
    ssl_certificate /etc/nginx/ssl/hermes.crt;
    ssl_certificate_key /etc/nginx/ssl/hermes.key;
    server_name _;

    # The app bundle is ~1.8 MB uncompressed (index-*.js alone is over 1 MB)
    # and the stock nginx.conf leaves gzip off, so every first load shipped it
    # raw. Compressed on the fly rather than via gzip_static: Vite is not
    # configured to emit .gz siblings. gzip_proxied any because Cloudflare
    # fronts this origin, and forwarded requests would otherwise be skipped.
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json
               application/wasm image/svg+xml text/xml application/xml;

    add_header Permissions-Policy "microphone=(self)" always;

    # Redirect true plain-HTTP browser traffic to the encrypted port, but
    # exempt three things that also arrive as plain HTTP on :80 and must NOT
    # be redirected: (1) a Cloudflare tunnel — it terminates TLS at
    # Cloudflare's edge and forwards to this origin over plain HTTP, marking
    # the request with X-Forwarded-Proto: https; redirecting those would
    # break public access. (2) the container's own Docker healthcheck, which
    # curls http://127.0.0.1/ from inside the container and can't follow a
    # redirect to an HTTPS port with a self-signed cert. (3) /llm/ — the
    # token-gated llama.cpp proxy below: LAN clients like Cline reject our
    # self-signed cert outright with no override, so this path is
    # deliberately reachable over plain HTTP; the bearer-token check in the
    # location block is the only auth for it either way. The old /ollama/
    # path shares the exemption so a stale client still reads its 410.
    set $needs_https_redirect 0;
    if ($scheme = "http") { set $needs_https_redirect 1; }
    if ($http_x_forwarded_proto = "https") { set $needs_https_redirect 0; }
    if ($remote_addr = "127.0.0.1") { set $needs_https_redirect 0; }
    if ($request_uri ~ "^/(llm|ollama)/") { set $needs_https_redirect 0; }
    if ($needs_https_redirect) {
        return 301 https://$host:9443$request_uri;
    }

    root /usr/share/nginx/html;
    index index.html;

    # Docker's embedded DNS (127.0.0.11) + a variable in proxy_pass forces nginx to
    # re-resolve "backend" instead of caching the IP from worker startup — without
    # this, recreating the backend container (any redeploy) leaves nginx pointing at
    # the old, now-dead IP until the frontend container is also restarted, causing a
    # live 502 outage on every backend-only deploy.
    resolver 127.0.0.11 valid=10s;
    set $backend_upstream http://backend:8000;
    set $llm_upstream http://hermes-llama:8080;

    # Proxy API requests to backend
    # NOTE: proxy_pass has no URI part here on purpose. With a variable in
    # proxy_pass, nginx does NOT do the usual "replace matched location
    # prefix, append the rest of the URI" substitution — it only appends the
    # full original request URI automatically when proxy_pass has no URI of
    # its own. Adding a literal suffix like "$backend_upstream/api/" silently
    # drops everything past the location prefix (e.g. /api/auth/request-code
    # was proxied as bare /api/), breaking every REST endpoint.
    location /api/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
    }

    # Live view of an agent desktop (VNC over WebSocket). A screen that is not
    # changing sends nothing for a while, so the /api/ 120s read timeout would
    # cut the owner's view mid-watch.
    location ~ ^/api/agent-desktops/[a-z0-9-]+/vnc$ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # Proxy WebSocket connections
    location /api/ws {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # Model *listing* is deliberately not token-gated. Some OpenAI-compatible
    # clients (Cline among them) fetch the catalogue without an Authorization
    # header, and with the whole prefix gated their settings pane shows no models
    # while chat — which *does* send the token — works fine. Model names are not
    # a secret; every endpoint that can run inference stays behind the bearer
    # token in the location below. Exact-match location, so it wins over the
    # /llm/ prefix, and private source addresses only, so the catalogue is not
    # exposed to whatever sits in front of this nginx.
    location = /llm/v1/models {
        allow 127.0.0.0/8;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
        rewrite ^/llm/(.*)$ /$1 break;
        proxy_pass $llm_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # Token-gated reverse proxy onto the internal llama.cpp server, so external
    # OpenAI-compatible clients (Cline, etc.) can reach the local model with a
    # single bearer token instead of an SSH tunnel: base URL <host>/llm/v1.
    # ${LLM_PROXY_TOKEN} is baked in at container start by nginx's own
    # envsubst-on-templates entrypoint (this file lives under
    # /etc/nginx/templates/), so by the time nginx parses the config it's a fixed
    # literal, not a live variable. The rewrite+break before a URI-less
    # proxy_pass is nginx's documented way to strip the /llm prefix without
    # hitting the proxy_pass-with-variable trap noted above (variable + literal
    # suffix silently drops the rest of the path) — rewrite ... break followed by
    # a bare proxy_pass $var forwards the *rewritten* URI, not the original one.
    location /llm/ {
        if ($http_authorization != "Bearer ${LLM_PROXY_TOKEN}") {
            return 401;
        }
        # Through the backend (backend/uncensored_mode.py): it adds the owner's uncensored-mode switch to every
        # request, so Cline follows the Settings toggle without restarting the model.
        rewrite ^/llm/(.*)$ /llm-open/$1 break;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # The model's window is 196608 tokens, roughly 1 MB of JSON — exactly
        # nginx's default body limit, so long prompts were silently 413ing and
        # capping usable context. Vision requests carry base64 images on top.
        client_max_body_size 256m;
        # Without this every prompt over 16k gets spooled to /var/cache/nginx
        # first ("a client request body is buffered to a temporary file").
        client_body_buffer_size 2m;
        # Prompt processing of a full context runs minutes before the first
        # token, and thinking adds more; 300 s cut those requests off.
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        # Chat completions stream as SSE. With nginx's default buffering the
        # client gets nothing until a buffer fills, which reads as a hung
        # "Thinking..." instead of tokens appearing as they are generated.
        proxy_buffering off;
        proxy_cache off;
    }

    # The Ollama-era path. The local model is served by llama.cpp now, which
    # does not speak the Ollama API, so tell a stale client where to go instead
    # of letting the SPA fallback answer 200 with index.html.
    location /ollama/ {
        default_type text/plain;
        return 410 "Moved: the local model is now served by llama.cpp at /llm/v1 (OpenAI-compatible, same bearer token).\n";
    }

    # Kanban dev-run demo previews — static files only, no proxying, so the
    # proxy_pass-with-variable path-dropping trap above does not apply here.
    # Populated by backend/tools.py's dev_publish_demo tool into
    # backend/data/dev-previews/<run_id>/, mounted read-only below.
    location /demo/ {
        alias /usr/share/nginx/dev-previews/;
        autoindex off;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ $uri/index.html =404;
    }

    # Vite fingerprints every file under /assets/ with a content hash, so a given
    # URL's bytes can never change — cache it hard and skip the revalidation
    # round-trip entirely. A new build produces new filenames, not new contents.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # index.html is the one file whose URL is stable while its contents change on
    # every deploy — it's what points at the hashed bundles. Served with no
    # Cache-Control at all, browsers fall back to RFC 9111 heuristic freshness and
    # may reuse a cached copy without ever asking the server, so a deployed fix can
    # sit unused in a tab that is never hard-reloaded (this happened: a voice fix
    # looked like it "changed nothing" for an hour while the old bundle kept
    # running). "no-cache" still allows caching but forces revalidation, so the
    # 304 path keeps it cheap.
    #
    # Permissions-Policy is repeated here on purpose: nginx's add_header is only
    # inherited by a location that declares none of its own, so without this line
    # the microphone grant would be silently dropped from the HTML document.
    location = /index.html {
        add_header Permissions-Policy "microphone=(self)" always;
        add_header Cache-Control "no-cache" always;
    }

    # The service worker must never be cached. A cached sw.js is how a browser
    # keeps running the previous build's worker forever: the new one is only
    # installed when the byte content at this exact URL changes, and it cannot
    # change if the response came from cache. Same reasoning as index.html.
    location = /sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Service-Worker-Allowed "/" always;
        try_files $uri =404;
    }

    location = /manifest.json {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # Icons live at stable URLs whose contents change on a rebrand; without
    # Cache-Control the browser kept showing the old logo from heuristic cache
    # after a deploy.
    location ~ ^/(favicon\.(svg|ico)|vexa-icon\.svg|apple-touch-icon\.png|icon-(192|512)\.png)$ {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # SPA fallback — all other routes serve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
